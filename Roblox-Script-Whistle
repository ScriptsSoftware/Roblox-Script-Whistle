local function isPlayerLookingAtModel(model)
	local toModel=(model:GetPivot().Position-Camera.CFrame.Position).Unit
	local dot=Camera.CFrame.LookVector:Dot(toModel)
	return dot>0.5
end

local function teleportModel(model)
	local spot=hideSpots[math.random(1,#hideSpots)]
	local yHeight=model:GetExtentsSize().Y/2+5
	local cf=CFrame.new(spot.X,yHeight,spot.Z)
	cf=CFrame.new(spot,HumanoidRootPart.Position)
	model:PivotTo(cf)
end

RunService.Heartbeat:Connect(function()
	if originalModel and originalModel.Parent then
		local pos=originalModel:GetPivot().Position
		local dist=(HumanoidRootPart.Position-pos).Magnitude
		if dist>DISTANCE_THRESHOLD then
			local dir=(HumanoidRootPart.Position-pos).Unit
			local targetPos=Vector3.new(pos.X+dir.X*2*0.016,spawnHeight,pos.Z+dir.Z*0.016)
			originalModel:PivotTo(CFrame.new(targetPos))
		end
		if isPlayerLookingAtModel(originalModel) then
			if not lastSeenTime then lastSeenTime=tick()
			elseif tick()-lastSeenTime>=TELEPORT_DELAY then
				teleportModel(originalModel)
				lastSeenTime=nil
			end
		else lastSeenTime=nil end
		local lookCF=CFrame.new(originalModel:GetPivot().Position,HumanoidRootPart.Position)
		local currentCFrame=originalModel:GetPivot()
		originalModel:PivotTo(CFrame.new(currentCFrame.Position,HumanoidRootPart.Position))
	end
end)

local cloneActive=false
local function CloneMe(char)
	char.Archivable=true
	local clone=char:Clone()
	char.Archivable=false
	return clone
end

local function spawnFakeClone()
	if cloneActive then return end
	cloneActive=true
	local players={}
	for _,p in pairs(Players:GetPlayers()) do
		if p~=LocalPlayer then table.insert(players,p) end
	end
	if #players==0 then cloneActive=false return end
	local chosen=players[math.random(1,#players)]
	if not chosen.Character then cloneActive=false return end
	local charClone=CloneMe(chosen.Character)
	charClone.Parent=workspace
	originalModel.Parent=nil
	chosen.Character.Parent=nil
	local humanoid=charClone:FindFirstChildOfClass("Humanoid")
	if not humanoid then cloneActive=false return end

	local anims={}
	local r15=false
	if humanoid.RigType==Enum.HumanoidRigType.R15 then r15=true end
	anims.idle=Instance.new("Animation")
	anims.walk=Instance.new("Animation")
	if r15 then
		anims.idle.AnimationId="rbxassetid://507766388"
		anims.walk.AnimationId="rbxassetid://913376220"
	else
		anims.idle.AnimationId="rbxassetid://180435571"
		anims.walk.AnimationId="rbxassetid://180426354"
	end
	local trackIdle=humanoid:LoadAnimation(anims.idle)
	local trackWalk=humanoid:LoadAnimation(anims.walk)
	trackIdle:Play()

	task.spawn(function()
		while charClone.Parent do
			local dist=(HumanoidRootPart.Position-charClone:GetPivot().Position).Magnitude
			if dist>17 then
				humanoid:MoveTo(HumanoidRootPart.Position)
				if not trackWalk.IsPlaying then trackWalk:Play() end
				if trackIdle.IsPlaying then trackIdle:Stop() end
			else
				if not trackIdle.IsPlaying then trackIdle:Play() end
				if trackWalk.IsPlaying then trackWalk:Stop() end
			end
			task.wait(0.3)
		end
	end)

	task.spawn(function()
		while charClone.Parent do
			local msg=chatMessages[math.random(1,#chatMessages)]
			ChatService:Chat(charClone.Head,msg,Enum.ChatColor.White)
			task.wait(math.random(8,16))
		end
	end)

	task.spawn(function()
		while charClone.Parent do
			local s=Instance.new("Sound")
			s.SoundId="rbxassetid://"..soundIds[math.random(1,2)]
			s.Volume=1
			s.Parent=workspace
			s:Play()
			s.Ended:Wait()
			task.wait(math.random(5,10))
		end
	end)

	local lastLook=nil
	local removeDelay=15
	local conn
	conn=RunService.Heartbeat:Connect(function()
		if charClone.Parent then
			local look=isPlayerLookingAtModel(charClone)
			if look then
				if not lastLook then lastLook=tick()
				elseif tick()-lastLook>=removeDelay then
					charClone:Destroy()
					originalModel.Parent=workspace
					chosen.Character.Parent=workspace
					cloneActive=false
					conn:Disconnect()
				end
			else lastLook=nil end
		end
	end)
end

